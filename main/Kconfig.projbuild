choice XIAOZHI_NETWORK_TYPE
    prompt "Network Type"
    depends on BOARD_TYPE_WAVESHARE_ESP32_P4_NANO
    default XIAOZHI_NETWORK_WIFI
    help
        Select the network connection used by this board.

    config XIAOZHI_NETWORK_WIFI
        bool "WiFi"

    config XIAOZHI_NETWORK_ETHERNET
        bool "Ethernet"
        select ETH_ENABLED
        select ETH_USE_ESP32_EMAC
        help
            Use the onboard Ethernet port for network access.
endchoice

menu "Ethernet Configuration"
    depends on XIAOZHI_NETWORK_ETHERNET

    choice XIAOZHI_ETH_PHY_MODEL
        prompt "Ethernet PHY Device"
        default XIAOZHI_ETH_PHY_IP101

        config XIAOZHI_ETH_PHY_IP101
            bool "IP101/IP101GR"
            help
                IP101/IP101GR 10/100M Ethernet PHY, used by Waveshare ESP32-P4-NANO.
    endchoice

    config XIAOZHI_ETH_MDC_GPIO
        int "Ethernet SMI MDC GPIO"
        range 0 54
        default 31 if BOARD_TYPE_WAVESHARE_ESP32_P4_NANO
        default 31
        help
            GPIO used by the Ethernet SMI MDC signal.

    config XIAOZHI_ETH_MDIO_GPIO
        int "Ethernet SMI MDIO GPIO"
        range 0 54
        default 52 if BOARD_TYPE_WAVESHARE_ESP32_P4_NANO
        default 52
        help
            GPIO used by the Ethernet SMI MDIO signal.

    config XIAOZHI_ETH_PHY_ADDR
        int "Ethernet PHY Address"
        range -1 31
        default 1
        help
            Set the PHY address according to the board schematic.
            Use -1 to let the driver search for the PHY address.

    config XIAOZHI_ETH_PHY_RST_GPIO
        int "Ethernet PHY Reset GPIO"
        range -1 54
        default 51 if BOARD_TYPE_WAVESHARE_ESP32_P4_NANO
        default -1
        help
            GPIO used to reset the Ethernet PHY. Set to -1 if not connected.

endmenu

choice ESP32_S3_LCD_EV_BOARD_VERSION
    depends on BOARD_TYPE_ESP32_S3_LCD_EV_BOARD
    prompt "EV_BOARD Type"
    default ESP32_S3_LCD_EV_BOARD_V1_4
    config ESP32_S3_LCD_EV_BOARD_V1_4
        bool "Espressif ESP32-S3-LCD-EV-Board-MB v1.4"
    config ESP32_S3_LCD_EV_BOARD_V1_5
        bool "Espressif ESP32-S3-LCD-EV-Board-MB v1.5"
endchoice

menuconfig BREAD_COMPACT_WIFI_TFT_128X160
    bool "Add secondary SPI TFT for images"
    depends on BOARD_TYPE_BREAD_COMPACT_WIFI
    select LV_USE_LODEPNG
    select LV_USE_LINE
    default n
    help
        Add a secondary SPI TFT; select its controller and resolution below.
        The selected OLED remains the primary assistant/emoji display.
        Legacy microphone pins 12/13/14 require TFT pins CS38/RST40/DC41.
        Connect the display backlight separately; no backlight GPIO is assigned.

if BREAD_COMPACT_WIFI_TFT_128X160

config BREAD_COMPACT_WIFI_TFT_USE_CS38_RST40_DC41
    bool "Use TFT pins CS38/RST40/DC41 (off: CS12/RST14/DC13)"
    depends on IDF_TARGET_ESP32S3
    default n
    help
        Enable for TFT wiring CS=GPIO38, RST=GPIO40, DC=GPIO41.
        Disable to retain the original CS=GPIO12, RST=GPIO14, DC=GPIO13.
        Both configurations use MOSI=GPIO15 and SCK=GPIO2.
        For release builds, use a variant with a distinct board name.

choice BREAD_COMPACT_WIFI_TFT_PANEL
    prompt "Secondary TFT controller / resolution"
    depends on BREAD_COMPACT_WIFI_TFT_128X160
    default BREAD_COMPACT_WIFI_TFT_ST7735_160X128

config BREAD_COMPACT_WIFI_TFT_ST7735_160X128
    bool "ST7735 1.8 inch, 160x128 landscape (existing wiring)"

config BREAD_COMPACT_WIFI_TFT_ST7789_320X240
    bool "ST7789 2 inch, 320x240 landscape"
    help
        Native 240x320 panel rotated to landscape, using the ESP-IDF ST7789 driver.
        Same SPI pins as the 1.8 inch display; connect backlight separately.
        Existing screen tools and SD GIF emoji use the selected resolution.

config BREAD_COMPACT_WIFI_TFT_ILI9341_320X240
    bool "ILI9341 3.2 inch SPI V2.0, 320x240 landscape"
    help
        Native 240x320 panel rotated to landscape with the ILI9341 driver.
        Uses RGB565 over standard SPI, with the existing secondary TFT pins.
        Select this for the 3.2 inch ILI9341 module previously mistaken for ILI9486.
        Connect the backlight separately; touch and the module's SD socket are not used.

config BREAD_COMPACT_WIFI_TFT_ILI9486_480X320
    bool "ILI9486 3.5 inch, 480x320 landscape"
    depends on IDF_TARGET_ESP32S3 && SPIRAM
    help
        Uses Robot-compatible SPI framing with RGB666 output, as confirmed
        by the LCD diagnostic. LVGL RGB565 pixels are converted by panel IO.
        Same SPI pins as the 1.8 inch display; connect backlight separately.
        Enable SD card GIF support below for animated image emoji.
endchoice

config BREAD_COMPACT_WIFI_TFT_ST7789_INVERT_COLOR
    bool "ST7789 display color inversion (usually enabled for IPS)"
    depends on BREAD_COMPACT_WIFI_TFT_ST7789_320X240
    default y
    help
        Matches the ST7789 IPS initialization used by Xiaozhi-Robot.
        Disable for a module requiring non-inverted display output.

config BREAD_COMPACT_WIFI_TFT_ILI9341_INVERT_COLOR
    bool "ILI9341 display color inversion"
    depends on BREAD_COMPACT_WIFI_TFT_ILI9341_320X240
    default n
    help
        Enable if the module requires inverted output (for example an IPS panel).
        Verify color and orientation on hardware; start with TFT SPI clock at 10 MHz.

config BREAD_COMPACT_WIFI_TFT_SPI_MHZ
    int "Secondary TFT SPI clock (MHz)"
    depends on BREAD_COMPACT_WIFI_TFT_128X160
    range 1 40
    default 10
    help
        SPI transfer clock, not panel refresh rate. Start at 10 MHz;
        higher values require checking the panel and wiring on hardware.

menuconfig BREAD_COMPACT_WIFI_TFT_SDCARD
    bool "Read TFT GIF files from SDMMC (CLK10/CMD11/D0-16)"
    depends on BREAD_COMPACT_WIFI_TFT_128X160 && IDF_TARGET_ESP32S3
    select LV_USE_GIF
    default n
    help
        Read GIFs from a FAT32 card mounted at /sdcard.
        SDMMC runs in 1-bit mode at up to 40 MHz, independently of TFT SPI.
        The GIF directory and transfer clock ceiling are configured below. Never format
        by firmware. SH1106 emoji rendering remains unchanged.

if BREAD_COMPACT_WIFI_TFT_SDCARD

config BREAD_COMPACT_WIFI_TFT_GIF_DIRECTORY
    string "Secondary TFT GIF directory relative to SD root"
    depends on BREAD_COMPACT_WIFI_TFT_SDCARD
    default "Kira-Emotes/Kira-Emotes/gif"
    help
        Accepts / or backslash as separators; firmware normalizes them to /.
        No drive letter, leading/trailing separator, empty, . or .. components.
        Spaces are supported, for example Kira-Emotes 2/Kira-Emotes/gif.
        Keep the 25 named GIF files in this folder. Maximum path length: 128 bytes.
        This selects files; it does not recolor their opaque background pixels.

config BREAD_COMPACT_WIFI_TFT_SD_MHZ
    int "Secondary TFT SDMMC transfer clock ceiling (MHz)"
    depends on BREAD_COMPACT_WIFI_TFT_SDCARD
    range 10 40
    default 40
    help
        1-bit SDMMC. Typical values: 10, 20, 40 MHz. Transient mount failures
        retry with ceilings no higher than this setting, then at most 20/10 MHz.
        This ceiling does not change the driver's identification clock.

menuconfig BREAD_COMPACT_WIFI_ILI9486_SD_TEST
    bool "Run standalone ILI9486 LCD + SD diagnostic at boot"
    depends on BREAD_COMPACT_WIFI_TFT_ILI9486_480X320 && BREAD_COMPACT_WIFI_TFT_SDCARD
    default n
    help
        Run only raw SPI color/grid tests and an SD GIF, bypassing the assistant,
        audio, Wi-Fi, camera and LVGL display rendering. Uses the confirmed
        RGB666 format with native 320x480 addressing and software rotation.
        Turn off this option to restore normal firmware operation.

if BREAD_COMPACT_WIFI_ILI9486_SD_TEST

config BREAD_COMPACT_WIFI_LCD_TEST_SPI_MHZ
    int "LCD diagnostic SPI clock (MHz)"
    depends on BREAD_COMPACT_WIFI_ILI9486_SD_TEST
    range 1 20
    default 5

config BREAD_COMPACT_WIFI_LCD_TEST_GIF
    string "LCD diagnostic GIF filename in configured SD directory"
    depends on BREAD_COMPACT_WIFI_ILI9486_SD_TEST
    default "neutral.gif"

endif # BREAD_COMPACT_WIFI_ILI9486_SD_TEST

endif # BREAD_COMPACT_WIFI_TFT_SDCARD

menuconfig BREAD_COMPACT_WIFI_LCD_IMAGE_TEST
    bool "Run LCD EduHub image slideshow at boot (ST7789 / ILI9341)"
    depends on (BREAD_COMPACT_WIFI_TFT_ST7789_320X240 || BREAD_COMPACT_WIFI_TFT_ILI9341_320X240) && !BREAD_COMPACT_WIFI_TFT_SDCARD
    depends on !BREAD_COMPACT_WIFI_TFT_WORD_IMAGES_SD
    default n
    help
        Start a background slideshow after the normal firmware connects to Wi-Fi.
        Downloads five built-in public test illustrations directly from EduHub.
        No account, Robot token, lesson ID or image URL configuration is needed.
        Uses the existing TFT PNG/JPEG downloader. Assistant and Wi-Fi setup
        remain active; TFT MCP tools are disabled to keep the slideshow in control.
        Disable SD support and select HTTP/S3 vocabulary images for this test.

if BREAD_COMPACT_WIFI_LCD_IMAGE_TEST

config BREAD_COMPACT_WIFI_LCD_IMAGE_TEST_SPI_MHZ
    int "LCD image diagnostic SPI clock (MHz)"
    range 1 20
    default 10
    help
        Overrides the normal TFT SPI clock while slideshow diagnostic mode is enabled.
        Start at 10 MHz when investigating an all-white display.

config BREAD_COMPACT_WIFI_LCD_IMAGE_TEST_COLORS
    bool "Test direct LCD solid colors and LVGL text before slideshow"
    default y
    help
        Before LVGL starts, send red, green, blue, white and black directly to
        panel RAM using synchronous SPI. Then show LCD TEST through LVGL.
        Solid colors prove the panel accepts writes independently of Wi-Fi,
        JPEG decoding and LVGL. White throughout requires checking wiring/init.

config BREAD_COMPACT_WIFI_LCD_IMAGE_TEST_COUNT
    int "Number of public test images"
    range 1 5
    default 5
    help
        Show the first N images from the built-in EduHub public sample list,
        then loop back to the first. No authenticated API calls are made.

config BREAD_COMPACT_WIFI_LCD_IMAGE_TEST_SECONDS
    int "Display time per image after loading (seconds)"
    range 1 3600
    default 10

endif # BREAD_COMPACT_WIFI_LCD_IMAGE_TEST

choice BREAD_COMPACT_WIFI_TFT_WORD_IMAGE_SOURCE
    prompt "Vocabulary image source"
    depends on BREAD_COMPACT_WIFI_TFT_128X160
    default BREAD_COMPACT_WIFI_TFT_WORD_IMAGES_HTTP

config BREAD_COMPACT_WIFI_TFT_WORD_IMAGES_HTTP
    bool "HTTP/S3 (download images from EduHub)"

config BREAD_COMPACT_WIFI_TFT_WORD_IMAGES_SD
    bool "SD card (exported word-images ZIP, no HTTP fallback)"
    depends on BREAD_COMPACT_WIFI_TFT_SDCARD
    help
        Extract the EduHub ZIP at SD root: /manifest.json and /word-images/*.jpg.
        Advertises self.screen.show_word_image(lessonId,key) to display directly
        from SD, avoiding english_get_word_image and image HTTP downloads.
        Missing/corrupt files report an error; no automatic HTTP fallback.
endchoice

endif # BREAD_COMPACT_WIFI_TFT_128X160

choice DISPLAY_OLED_TYPE
    depends on BOARD_TYPE_BREAD_COMPACT_WIFI || BOARD_TYPE_BREAD_COMPACT_ML307 || BOARD_TYPE_BREAD_COMPACT_NT26 || BOARD_TYPE_BREAD_COMPACT_ESP32 || BOARD_TYPE_HU_087
    prompt "OLED Type"
    default OLED_SSD1306_128X32
    help
        OLED Monochrome Display Type
    config OLED_SSD1306_128X32
        bool "SSD1306 128*32"
    config OLED_SSD1306_128X64
        bool "SSD1306 128*64"
    config OLED_SH1106_128X64
        bool "SH1106 128*64"
endchoice

config BREAD_COMPACT_WIFI_SH1106_EMOJI_ONLY
    bool "Show full-screen animated emoji only"
    depends on BOARD_TYPE_BREAD_COMPACT_WIFI && OLED_SH1106_128X64
    default y if BREAD_COMPACT_WIFI_TFT_128X160
    default n
    help
        Use the complete 128x64 SH1106 area for a monochrome animated face.
        Status text, notifications, chat text, and status-bar icons are hidden.
        Disable this option to restore the standard OLED user interface.

config BREAD_COMPACT_WIFI_HUB_MUSIC_TEST
    bool "Enable Robot Hub music test (search/play)"
    depends on BOARD_TYPE_BREAD_COMPACT_WIFI && IDF_TARGET_ESP32S3
    default n
    help
        Enable self.music.play_url and self.music.stop for testing private
        Robot Hub MP3 playback. The assistant uses the server-side tools
        music__search_music and music__play_music through your connected MCP
        endpoint, then passes the returned stream URL to self.music.play_url.
        Once after startup reaches idle, send an embedded spoken music request
        to the existing voice host. The host uses the connected Robot Hub MCP
        tools music__search_music and music__play_music, then invokes the device
        tool self.music.play_url. No extra robot credential is required here.
        Requires the Robot Hub music tools to be enabled on the host endpoint.
        This tests the real host/ASR/MCP flow; tool selection depends on the
        assistant prompt. Disabling this removes music tools and the boot test.

config BREAD_COMPACT_WIFI_USE_LEGACY_MIC_PINS
    bool "Use legacy microphone pins (GPIO14/GPIO13/GPIO12)"
    depends on BOARD_TYPE_BREAD_COMPACT_WIFI
    depends on !BREAD_COMPACT_WIFI_TFT_128X160 || BREAD_COMPACT_WIFI_TFT_USE_CS38_RST40_DC41
    default n
    help
        Select the legacy microphone connection: BCLK/SCK=GPIO14,
        DATA_OUT/DIN=GPIO13, and WS=GPIO12.
        With the secondary TFT enabled, first select TFT pins CS38/RST40/DC41
        to avoid conflicts with the microphone pins.

        Leave this disabled for the current SPH0645 microphone schematic:
        BCLK/SCK=GPIO47, DATA_OUT/DIN=GPIO45, and WS=GPIO48. GPIO47 and
        GPIO48 are shared with the speaker through one full-duplex I2S bus.

config BREAD_COMPACT_WIFI_SPH0645_PCM_SHIFT
    int "SPH0645 microphone 32-bit to 16-bit shift"
    depends on BOARD_TYPE_BREAD_COMPACT_WIFI && !BREAD_COMPACT_WIFI_USE_LEGACY_MIC_PINS
    range 12 20
    default 16
    help
        Number of bits removed when converting the left-aligned SPH0645 sample
        from the 32-bit I2S slot to signed 16-bit PCM for AFE/WakeNet.

        Use 16 for the native 24-bit microphone data. Decrease this value only
        if the microphone is too quiet. Increase it if the PCM clipping counter
        is still high. A permanently saturated signal prevents wake-word
        detection.

choice BREAD_COMPACT_WIFI_BUTTON_A_ACTION
    prompt "Button A short-press action"
    depends on BOARD_TYPE_BREAD_COMPACT_WIFI
    default BREAD_COMPACT_WIFI_BUTTON_A_GAME

config BREAD_COMPACT_WIFI_BUTTON_A_GAME
    bool "Cycle idle GIF / start Rock Paper Scissors (existing behavior)"

config BREAD_COMPACT_WIFI_BUTTON_A_VOLUME_UP
    bool "Increase speaker volume"

config BREAD_COMPACT_WIFI_BUTTON_A_VOLUME_DOWN
    bool "Decrease speaker volume"

endchoice

choice BREAD_COMPACT_WIFI_BUTTON_B_ACTION
    prompt "Button B short-press action"
    depends on BOARD_TYPE_BREAD_COMPACT_WIFI
    default BREAD_COMPACT_WIFI_BUTTON_B_SHOW_QR
    help
        Select QR code, conversation or speaker volume adjustment.

config BREAD_COMPACT_WIFI_BUTTON_B_SHOW_QR
    bool "Show local-control QR code"

config BREAD_COMPACT_WIFI_BUTTON_B_WAKE_WORD
    bool "Start conversation (local wake-word event)"

config BREAD_COMPACT_WIFI_BUTTON_B_VOLUME_UP
    bool "Increase speaker volume"

config BREAD_COMPACT_WIFI_BUTTON_B_VOLUME_DOWN
    bool "Decrease speaker volume"

endchoice

config BREAD_COMPACT_WIFI_BUTTON_VOLUME_STEP
    int "Button volume adjustment step (percentage points)"
    depends on BOARD_TYPE_BREAD_COMPACT_WIFI
    range 1 30
    default 10
    help
        Used by either button assigned to volume up/down. Volume is clamped to 0..100.
        Button A long press still stops Rock Paper Scissors.

config BREAD_COMPACT_WIFI_BUTTON_B_WAKE_WORD_TEXT
    string "Button B wake-word text"
    depends on BREAD_COMPACT_WIFI_BUTTON_B_WAKE_WORD
    default "Hey Kira"
    help
        Wake-word text reported to the application/server when Button B is
        configured to start a conversation.

menu "Bread Compact WiFi wheel movement"
    depends on BOARD_TYPE_BREAD_COMPACT_WIFI

config BREAD_COMPACT_WIFI_MOVEMENT_STOP_PULSE_US
    int "Stop both wheels: PCA9685 PWM11/PWM12 pulse (microseconds)"
    range 500 3000
    default 1700
    help
        Neutral PWM pulse used to stop the continuous-rotation servos on
        PCA9685 channels 11 and 12. Adjust this value if either wheel creeps
        while stopped. Typical servos stop near 1500 us; this robot is
        calibrated to 1700 us by default.

config BREAD_COMPACT_WIFI_FORWARD_LEFT_WHEEL_PULSE_US
    int "Move forward: LEFT wheel / PCA9685 PWM11 pulse (microseconds)"
    range 500 3000
    default 1000
    help
        PWM pulse for the left continuous-rotation servo on PCA9685 channel 11
        while the move_forward tool is active.

config BREAD_COMPACT_WIFI_FORWARD_RIGHT_WHEEL_PULSE_US
    int "Move forward: RIGHT wheel / PCA9685 PWM12 pulse (microseconds)"
    range 500 3000
    default 2500
    help
        PWM pulse for the right continuous-rotation servo on PCA9685 channel 12
        while the move_forward tool is active.

config BREAD_COMPACT_WIFI_BACKWARD_LEFT_WHEEL_PULSE_US
    int "Move backward: LEFT wheel / PCA9685 PWM11 pulse (microseconds)"
    range 500 3000
    default 2500
    help
        PWM pulse for the left continuous-rotation servo on PCA9685 channel 11
        while the move_backward tool is active.

config BREAD_COMPACT_WIFI_BACKWARD_RIGHT_WHEEL_PULSE_US
    int "Move backward: RIGHT wheel / PCA9685 PWM12 pulse (microseconds)"
    range 500 3000
    default 1000
    help
        PWM pulse for the right continuous-rotation servo on PCA9685 channel 12
        while the move_backward tool is active.

config BREAD_COMPACT_WIFI_SPIN_LEFT_WHEEL_PULSE_US
    int "Spin around: LEFT wheel / PCA9685 PWM11 pulse (microseconds)"
    range 500 3000
    default 1000
    help
        PWM pulse for the left continuous-rotation servo on PCA9685 channel 11
        while the spin_around tool is active.

config BREAD_COMPACT_WIFI_SPIN_RIGHT_WHEEL_PULSE_US
    int "Spin around: RIGHT wheel / PCA9685 PWM12 pulse (microseconds)"
    range 500 3000
    default 1000
    help
        PWM pulse for the right continuous-rotation servo on PCA9685 channel 12
        while the spin_around tool is active.

config BREAD_COMPACT_WIFI_TURN_LEFT_LEFT_WHEEL_PULSE_US
    int "Turn left: LEFT wheel / PCA9685 PWM11 pulse (microseconds)"
    range 500 3000
    default 1700
    help
        PWM pulse for the left continuous-rotation servo on PCA9685 channel 11
        while the turn_left tool is active. The default stops the inside wheel.

config BREAD_COMPACT_WIFI_TURN_LEFT_RIGHT_WHEEL_PULSE_US
    int "Turn left: RIGHT wheel / PCA9685 PWM12 pulse (microseconds)"
    range 500 3000
    default 2500
    help
        PWM pulse for the right continuous-rotation servo on PCA9685 channel 12
        while the turn_left tool is active.

config BREAD_COMPACT_WIFI_TURN_RIGHT_LEFT_WHEEL_PULSE_US
    int "Turn right: LEFT wheel / PCA9685 PWM11 pulse (microseconds)"
    range 500 3000
    default 500
    help
        PWM pulse for the left continuous-rotation servo on PCA9685 channel 11
        while the turn_right tool is active.

config BREAD_COMPACT_WIFI_TURN_RIGHT_RIGHT_WHEEL_PULSE_US
    int "Turn right: RIGHT wheel / PCA9685 PWM12 pulse (microseconds)"
    range 500 3000
    default 1700
    help
        PWM pulse for the right continuous-rotation servo on PCA9685 channel 12
        while the turn_right tool is active. The default stops the inside wheel.

config BREAD_COMPACT_WIFI_DANCE_CLOCKWISE_LEFT_WHEEL_PULSE_US
    int "Dance clockwise: LEFT wheel / PCA9685 PWM11 pulse (microseconds)"
    range 500 3000
    default 1000
    help
        Left-wheel pulse used for the clockwise spin steps of the dance tool.
        The forward and backward dance steps use the corresponding movement
        settings above.

config BREAD_COMPACT_WIFI_DANCE_CLOCKWISE_RIGHT_WHEEL_PULSE_US
    int "Dance clockwise: RIGHT wheel / PCA9685 PWM12 pulse (microseconds)"
    range 500 3000
    default 1000
    help
        Right-wheel pulse used for the clockwise spin steps of the dance tool.

config BREAD_COMPACT_WIFI_DANCE_COUNTER_LEFT_WHEEL_PULSE_US
    int "Dance counterclockwise: LEFT wheel / PCA9685 PWM11 pulse (microseconds)"
    range 500 3000
    default 2500
    help
        Left-wheel pulse used for the counterclockwise spin steps of the dance
        tool.

config BREAD_COMPACT_WIFI_DANCE_COUNTER_RIGHT_WHEEL_PULSE_US
    int "Dance counterclockwise: RIGHT wheel / PCA9685 PWM12 pulse (microseconds)"
    range 500 3000
    default 2500
    help
        Right-wheel pulse used for the counterclockwise spin steps of the dance
        tool.

config BREAD_COMPACT_WIFI_DANCE_STEP_DURATION_MS
    int "Dance movement step duration (milliseconds)"
    range 100 2000
    default 350
    help
        Duration of each dance pose and wheel movement. Lower values make the
        choreography change direction faster; higher values make it slower.

endmenu

choice DISPLAY_LCD_TYPE
    depends on BOARD_TYPE_BREAD_COMPACT_WIFI_LCD || BOARD_TYPE_BREAD_COMPACT_ESP32_LCD || BOARD_TYPE_WDMOMO_CGC || BOARD_TYPE_BREAD_COMPACT_WIFI_CAM
    prompt "LCD Type"
    default LCD_ST7789_240X320
    help
        LCD Display Type
    config LCD_ST7789_240X320
        bool "ST7789 240*320, IPS"
    config LCD_ST7789_240X320_NO_IPS
        bool "ST7789 240*320, Non-IPS"
    config LCD_ST7789_170X320
        bool "ST7789 170*320"
    config LCD_ST7789_172X320
        bool "ST7789 172*320"
    config LCD_ST7789_240X280
        bool "ST7789 240*280"
    config LCD_ST7789_240X240
        bool "ST7789 240*240"
    config LCD_ST7789_240X240_7PIN
        bool "ST7789 240*240, 7PIN"
    config LCD_ST7789_240X135
        bool "ST7789 240*135"
    config LCD_ST7735_128X160
        bool "ST7735 128*160"
    config LCD_ST7735_128X128
        bool "ST7735 128*128"
    config LCD_ST7796_320X480
        bool "ST7796 320*480 IPS"
    config LCD_ST7796_320X480_NO_IPS
        bool "ST7796 320*480, Non-IPS"
    config LCD_ILI9341_240X320
        bool "ILI9341 240*320"
    config LCD_ILI9341_240X320_NO_IPS
        bool "ILI9341 240*320, Non-IPS"
    config LCD_GC9A01_240X240
        bool "GC9A01 240*240 Circle"
    config LCD_CUSTOM
        bool "Custom LCD (自定义屏幕参数)"
endchoice

choice DISPLAY_ESP32S3_KORVO2_V3
    depends on BOARD_TYPE_ESP32_S3_KORVO_2_V3 || BOARD_TYPE_ESP32_S3_KORVO_2_V3_RNDIS
    prompt "ESP32S3_KORVO2_V3 LCD Type"
    default ESP32S3_KORVO2_V3_LCD_ST7789
    help
        LCD Display Type
    config ESP32S3_KORVO2_V3_LCD_ST7789
        bool "ST7789 240*280"
    config ESP32S3_KORVO2_V3_LCD_ILI9341
        bool "ILI9341 240*320"
endchoice

choice DISPLAY_ESP32S3_CAM_XXXX
    depends on BOARD_TYPE_WAVESHARE_ESP32_S3_CAM_XXXX
    prompt "ESP32S3_CAM LCD Type"
    default BSP_LCD_SIZE_2INCH
    help
        LCD Display Type
    config BSP_LCD_SIZE_2INCH
        bool "2inch Touch LCD Module"

    config BSP_LCD_SIZE_2_8INCH
        bool "2.8inch Touch LCD Module"

    config BSP_LCD_SIZE_3_5INCH
        bool "3.5inch Touch LCD Module"

    config BSP_LCD_SIZE_1_83INCH
        bool "1.83inch Touch LCD Module"
endchoice

choice DISPLAY_ESP32S3_AUDIO_BOARD
    depends on BOARD_TYPE_WAVESHARE_ESP32_S3_AUDIO_BOARD
    prompt "ESP32S3_AUDIO_BOARD LCD Type"
    default AUDIO_BOARD_LCD_JD9853
    help
        LCD Display Type
    config AUDIO_BOARD_LCD_JD9853
        bool "JD9853 320*172"
    config AUDIO_BOARD_LCD_ST7789
        bool "ST7789 240*320"
endchoice

choice DISPLAY_ESP32S3_TOUCH_LCD_1_85C
    depends on BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_LCD_1_85C
    prompt "ESP32S3_TOUCH_LCD_1_85C version"
    default VERSION_2_0
    help
        hardware version
    config VERSION_1_0
        bool "version 1.0"
    config VERSION_2_0
        bool "version 2.0"
endchoice


choice DISPLAY_STYLE
    prompt "Select display style"
    default USE_DEFAULT_MESSAGE_STYLE
    help
        Select display style for Xiaozhi device

    config USE_DEFAULT_MESSAGE_STYLE
        bool "Enable default message style"

    config USE_WECHAT_MESSAGE_STYLE
        bool "Enable WeChat Message Style"

    config USE_EMOTE_MESSAGE_STYLE
        bool "Emote animation style"
        depends on BOARD_TYPE_ESP32_S3_BOX || BOARD_TYPE_ESP32_S3_BOX_3 \
            || BOARD_TYPE_ESP_VOCAT || BOARD_TYPE_LICHUANG_DEV_S3 || BOARD_TYPE_RYMCU_BIGSMART \
            || BOARD_TYPE_ESP_SENSAIRSHUTTLE
endchoice

config USE_MULTILINE_CHAT_MESSAGE
    bool "Use multiline chat message display (default mode only)"
    depends on USE_DEFAULT_MESSAGE_STYLE
    default n
    help
        When enabled, the chat message area in the default display mode shows
        multiple wrapped lines that grow upward from the bottom of the screen,
        with auto-adaptive height.
        When disabled (default), a single-line horizontally scrolling label
        is shown at the bottom of the screen.

choice WAKE_WORD_TYPE
    prompt "Wake Word Implementation Type"
    default USE_AFE_WAKE_WORD if (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4 || IDF_TARGET_ESP32S31) && SPIRAM
    default WAKE_WORD_DISABLED
    help
        Choose the type of wake word implementation to use

    config WAKE_WORD_DISABLED
        bool "Disabled"
        help
            Disable wake word detection

    config USE_ESP_WAKE_WORD
        bool "Wakenet model without AFE"
        depends on IDF_TARGET_ESP32C3 || IDF_TARGET_ESP32C5 || IDF_TARGET_ESP32C6 || (IDF_TARGET_ESP32 && SPIRAM)
        help
            Support ESP32 C3、ESP32 C5 与 ESP32 C6, and (ESP32 with PSRAM)

    config USE_AFE_WAKE_WORD
        bool "Wakenet model with AFE"
        depends on (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4 || IDF_TARGET_ESP32S31) && SPIRAM
        help
            Support AEC if available, requires ESP32-S3, ESP32-P4, or ESP32-S31 and PSRAM

    config USE_CUSTOM_WAKE_WORD
        bool "Multinet model (Custom Wake Word)"
        depends on (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4 || IDF_TARGET_ESP32S31) && SPIRAM
        help
            Requires ESP32-S3, ESP32-P4, or ESP32-S31 and PSRAM

endchoice

config CUSTOM_WAKE_WORD
    string "Custom Wake Word"
    default "xiao tu dou"
    depends on USE_CUSTOM_WAKE_WORD
    help
        Custom Wake Word, use pinyin for Chinese, separated by spaces

config CUSTOM_WAKE_WORD_DISPLAY
    string "Custom Wake Word Display"
    default "小土豆"
    depends on USE_CUSTOM_WAKE_WORD
    help
        Greeting sent to the server after wake word detection

config CUSTOM_WAKE_WORD_THRESHOLD
    int "Custom Wake Word Threshold (%)"
    default 20
    range 1 99
    depends on USE_CUSTOM_WAKE_WORD
    help
        Custom Wake Word Threshold, range 1-99, the smaller the more sensitive, default 20

config SEND_WAKE_WORD_DATA
    bool "Send Wake Word Data"
    default y
    depends on USE_AFE_WAKE_WORD || USE_CUSTOM_WAKE_WORD
    help
        Send wake word data to the server as the first message of the conversation and wait for response

config WAKE_WORD_DETECTION_IN_LISTENING
    bool "Enable Wake Word Detection in Listening Mode"
    default n
    depends on USE_AFE_WAKE_WORD || USE_CUSTOM_WAKE_WORD
    help
        Enable wake word detection while in listening mode.
        When enabled, the device can detect wake word during listening,
        which allows interrupting the current conversation.
        When disabled (default), wake word detection is turned off during listening.

config USE_AUDIO_PROCESSOR
    bool "Enable AFE Audio Processing"
    default y
    depends on (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4 || IDF_TARGET_ESP32S31) && SPIRAM
    help
        Enable the shared AFE uplink path with AEC and VAD. Noise suppression
        is not enabled because this project does not provide an NSNet model.
        Requires ESP32-S3, ESP32-P4, or ESP32-S31 with PSRAM.

config USE_DEVICE_AEC
    bool "Enable Device-Side AEC"
    default n
        depends on USE_AUDIO_PROCESSOR && (BOARD_TYPE_ESP32_S3_BOX_3 || BOARD_TYPE_ESP32_S3_BOX || BOARD_TYPE_ESP32_S3_BOX_LITE \
        || BOARD_TYPE_LICHUANG_DEV_S3 || BOARD_TYPE_RYMCU_BIGSMART || BOARD_TYPE_ESP32_S3_KORVO_2_V3 || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_AMOLED_1_75|| BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_AMOLED_1_75C || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_LCD_1_83\
        || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_AMOLED_2_06 || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_LCD_4B || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_4B || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_4_3 || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_5 \
        || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_7B \
        || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_3_4C || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_4C || BOARD_TYPE_ESP32_S3_LCD_EV_BOARD_2 || BOARD_TYPE_YUNLIAO_S3 \
        || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_7 || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_8 || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_10_1 \
        || BOARD_TYPE_ESP_VOCAT || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_LCD_3_49 || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_LCD_3_49_V2 || BOARD_TYPE_WAVESHARE_ESP32_S3_RLCD_4_2 || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_LCD_1_85B || BOARD_TYPE_ZHENGCHEN_CAM || BOARD_TYPE_ZHENGCHEN_CAM_ML307 \
        || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_LCD_4_3C || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_LCD_1_54 || BOARD_TYPE_WAVESHARE_ESP32_S3_LCD_0_85 || BOARD_TYPE_AI_VOX3 || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_AMOLED_1_43C || BOARD_TYPE_ATK_DNESP32S3_BOX3)
    help
        To work properly, device-side AEC requires a clean output reference path from the speaker signal and physical acoustic isolation between the microphone and speaker.

config USE_SERVER_AEC
    bool "Enable Server-Side AEC (Unstable)"
    default n
    depends on USE_AUDIO_PROCESSOR
    help
        To work perperly, server-side AEC requires server support

config USE_AUDIO_DEBUGGER
    bool "Enable Audio Debugger"
    default n
    help
        Enable audio debugger, send audio data through UDP to the host machine

menu "WiFi Configuration Method"
    help
        WiFi Configuration Method Selection
    config USE_HOTSPOT_WIFI_PROVISIONING
        bool "Hotspot"
        default y
        help
            Use WiFi Hotspot to transmit WiFi configuration data
    config USE_ESP_BLUFI_WIFI_PROVISIONING
        bool "ESP-BluFi"
        select BT_ENABLED
        select BT_BLE_42_FEATURES_SUPPORTED
        select BT_BLE_BLUFI_ENABLE
        help
            Use the PSA Crypto based BluFi security protocol adopted by ESP-IDF 6.
            The provisioning client must support ffdhe3072, SHA-256, and AES-CTR.
endmenu

config AUDIO_DEBUG_UDP_SERVER
    string "Audio Debug UDP Server Address"
    default "192.168.2.100:8000"
    depends on USE_AUDIO_DEBUGGER
    help
        UDP server address, format: IP:PORT, used to receive audio debugging data

config RECEIVE_CUSTOM_MESSAGE
    bool "Enable Custom Message Reception"
    default n
    help
        Enable custom message reception, allow the device to receive custom messages from the server (preferably through the MQTT protocol)

menu "Camera Configuration"
    depends on !IDF_TARGET_ESP32

    comment "Warning: Please read the help text before modifying these settings."

    config XIAOZHI_CAMERA_ALLOW_JPEG_INPUT
        bool "Allow JPEG Input"
        default n
        help
            Allow JPEG Input format for the camera.

            This option may need to be enabled when using a USB camera.

            Not currently supported when used simultaneously with XIAOZHI_ENABLE_ROTATE_CAMERA_IMAGE.

    config XIAOZHI_ENABLE_HARDWARE_JPEG_ENCODER
        bool "Enable Hardware JPEG Encoder"
        default y
        depends on SOC_JPEG_ENCODE_SUPPORTED
        help
            Use hardware JPEG encoder on ESP32-P4 to encode image to JPEG.
            See https://docs.espressif.com/projects/esp-idf/en/stable/esp32p4/api-reference/peripherals/jpeg.html for more details.

    config XIAOZHI_ENABLE_HARDWARE_JPEG_DECODER
        bool "Enable Hardware JPEG Decoder"
        default n
        depends on SOC_JPEG_DECODE_SUPPORTED && XIAOZHI_CAMERA_ALLOW_JPEG_INPUT
        help
            Use hardware JPEG decoder on ESP32-P4 to decode JPEG to image.
            See https://docs.espressif.com/projects/esp-idf/en/stable/esp32p4/api-reference/peripherals/jpeg.html for more details.

    config XIAOZHI_ENABLE_CAMERA_DEBUG_MODE
        bool "Enable Camera Debug Mode"
        default n
        help
            Enable camera debug mode, print camera debug information to the console.
            Only works on boards that support camera.

    config XIAOZHI_ENABLE_CAMERA_ENDIANNESS_SWAP
        bool "Enable software camera buffer endianness swapping"
        default n
        depends on !CAMERA_SENSOR_SWAP_PIXEL_BYTE_ORDER
        help
            This option treats the camera buffer as a uint16_t[] array and performs byte-swapping (endianness conversion) on each element.

            Should only be modified by development board integration engineers.

            **Incorrect usage may result in incorrect image colors!**

            ATTENTION: If the option CAMERA_SENSOR_SWAP_PIXEL_BYTE_ORDER is available for your sensor, please use that instead.

    menuconfig XIAOZHI_ENABLE_ROTATE_CAMERA_IMAGE
        bool "Enable Camera Image Rotation"
        default n
        depends on !XIAOZHI_CAMERA_ALLOW_JPEG_INPUT
        help
            Enable camera image rotation, rotate the camera image to the correct orientation.
            - On ESP32-P4, rotation is handled by PPA hardware.
            - On other chips, rotation is done in software with performance cost.
            - For 180° rotation, use HFlip + VFlip instead of this option.

            Not currently supported when used simultaneously with XIAOZHI_CAMERA_ALLOW_JPEG_INPUT.

    if XIAOZHI_ENABLE_ROTATE_CAMERA_IMAGE
        choice XIAOZHI_CAMERA_IMAGE_ROTATION_ANGLE
            prompt "Camera Image Rotation Angle (clockwise)"
            default XIAOZHI_CAMERA_IMAGE_ROTATION_ANGLE_90
            help
                Camera image rotation angle.
            config XIAOZHI_CAMERA_IMAGE_ROTATION_ANGLE_90
                bool "90°"
            config XIAOZHI_CAMERA_IMAGE_ROTATION_ANGLE_270
                bool "270°"
            comment "For 180° rotation, use HFlip + VFlip instead of this option"
        endchoice
    endif
endmenu

menu "TAIJIPAI_S3_CONFIG"
    depends on BOARD_TYPE_TAIJI_PI_S3
    choice I2S_TYPE_TAIJIPI_S3
        prompt "taiji-pi-S3 I2S Type"
        default TAIJIPAI_I2S_TYPE_STD
        help
            I2S 类型选择
        config TAIJIPAI_I2S_TYPE_STD
            bool "I2S Type STD"
        config TAIJIPAI_I2S_TYPE_PDM
            bool "I2S Type PDM"
    endchoice

    config I2S_USE_2SLOT
    bool "Enable I2S 2 Slot"
    default y
    help
        启动双声道
endmenu

endmenu
